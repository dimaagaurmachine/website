{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            ".claude/**",
            ".firebase/**",
            ".git/**",
            "**/.*/**",
            "**/node_modules/**",
            "_to-delete/**",
            "Logo Kit/**",
            "scripts/**",
            "README.md",
            "tailwind.config.js",
            "tailwind.input.css",
            "**/*Proposal*.pdf"
        ],
        "cleanUrls": false,
        "trailingSlash": false,
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "X-Content-Type-Options",
                        "value": "nosniff"
                    },
                    {
                        "key": "Referrer-Policy",
                        "value": "strict-origin-when-cross-origin"
                    },
                    {
                        "key": "X-Frame-Options",
                        "value": "SAMEORIGIN"
                    },
                    {
                        "key": "Permissions-Policy",
                        "value": "microphone=(self), camera=(), geolocation=()"
                    },
                    {
                        "key": "Strict-Transport-Security",
                        "value": "max-age=31536000"
                    }
                ]
            },
            {
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ],
                "regex": "^(/|.*\\.html)$"
            },
            {
                "source": "**/*.@(css|js)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600, must-revalidate"
                    }
                ]
            },
            {
                "source": "**/*.@(jpg|jpeg|png|webp|svg|ico|woff2)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=2592000"
                    }
                ]
            },
            {
                "source": "/site.webmanifest",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/manifest+json; charset=utf-8"
                    }
                ]
            },
            {
                "source": "/@(llms.txt|robots.txt)",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/plain; charset=utf-8"
                    }
                ]
            }
        ]
    }
}
